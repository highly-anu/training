{
  "_comment": "Golden cases for the workout matcher, asserted by BOTH implementations: test_workout_matcher.py (Python, src/workout_matcher.py) and frontend/src/lib/workoutMatcher.test.ts (TS, frontend/src/lib/workoutMatcher.ts). If you change scoring, update data/matching_rules.json and re-run both; a case that passes on one side and fails on the other means the two have drifted.",

  "scoreCases": [
    {
      "name": "exact modality and near-exact duration is the top score",
      "workout": { "inferredModalityId": "aerobic_base", "durationMinutes": 60 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 5
    },
    {
      "name": "exact modality, duration within 15 min",
      "workout": { "inferredModalityId": "max_strength", "durationMinutes": 50 },
      "sessionModality": "max_strength",
      "sessionDuration": 60,
      "expectedScore": 5
    },
    {
      "name": "exact modality, duration within 30 min",
      "workout": { "inferredModalityId": "max_strength", "durationMinutes": 35 },
      "sessionModality": "max_strength",
      "sessionDuration": 60,
      "expectedScore": 4
    },
    {
      "name": "exact modality, duration way off",
      "workout": { "inferredModalityId": "max_strength", "durationMinutes": 5 },
      "sessionModality": "max_strength",
      "sessionDuration": 60,
      "expectedScore": 3
    },
    {
      "name": "same family only, duration close",
      "workout": { "inferredModalityId": "anaerobic_intervals", "durationMinutes": 60 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 3
    },
    {
      "name": "different family, duration close",
      "workout": { "inferredModalityId": "max_strength", "durationMinutes": 60 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 2
    },
    {
      "name": "no inferred modality scores on duration alone",
      "workout": { "inferredModalityId": null, "durationMinutes": 60 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 2
    },
    {
      "name": "nothing agrees",
      "workout": { "inferredModalityId": "mobility", "durationMinutes": 120 },
      "sessionModality": "max_strength",
      "sessionDuration": 45,
      "expectedScore": 0
    },
    {
      "name": "duration boundary: exactly 15 min out still earns the top tier",
      "workout": { "inferredModalityId": "aerobic_base", "durationMinutes": 45 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 5
    },
    {
      "name": "duration boundary: exactly 30 min out earns the lower tier",
      "workout": { "inferredModalityId": "aerobic_base", "durationMinutes": 30 },
      "sessionModality": "aerobic_base",
      "sessionDuration": 60,
      "expectedScore": 4
    }
  ],

