{
  "_comment": "What each watch draws for a step: the server's exercise, its screen spec (none = the slot type's default), the engine's state, and the page it must show — title, the two fields and the gauge field as [label, value], the two lines under the rule, the spec's LAP action and what LAP then does. Both renderers run these: ios/TrainingCompanionTests/WatchSpecTests.swift (WatchSpecText) and garmin/core/test/SpecFixtures.mc, generated from this file by garmin/tools/gen_spec_fixtures.py (SpecRenderer). Change a screen here, never in one renderer; every vocabulary id must appear in some case (WatchSpecTests checks).",
  "cases": [
    {
      "name": "a working set, last time to beat",
      "exercise": {"exerciseId": "back_squat", "name": "Back Squat", "slotType": "sets_reps", "sets": 5, "reps": "5", "weightKg": 100, "last": "97.5kg × 5"},
      "state": {"reps": 5, "weightKg": 100, "setsDone": 0, "nextTitle": "Rest", "nextValue": "3:00"},
      "expect": {"title": "Back Squat  100 kg", "a": ["REPS", "5"], "b": ["SET", "1/5"], "gauge": ["SET", "1/5"],
                 "lines": ["Last time", "97.5kg × 5"], "lap": "complete_set", "outcome": "complete_set"}
    },
    {
      "name": "an unloaded set with a target RPE, side-tracked, after its first set",
      "exercise": {"exerciseId": "pistol_squat", "name": "Pistol Squat", "slotType": "sets_reps", "sets": 3, "reps": "5", "targetRpe": 8, "last": "5 reps"},
      "screen": {"template": "sets", "title": ["name", "side", "load"], "a": "reps", "b": "rpe_or_set", "gauge": "set",
                 "lines": "last_then_next", "lap": "complete_set", "behaviours": {"side_tracked": true}},
      "state": {"reps": 5, "rpe": 7.5, "setsDone": 1, "sideIsLeft": false, "nextTitle": "Rest", "nextValue": "1:30"},
      "expect": {"title": "Pistol Squat  Right", "a": ["REPS", "5"], "b": ["RPE", "7.5"], "gauge": ["SET", "2/3"],
                 "lines": ["Next: Rest", "1:30"], "lap": "complete_set", "outcome": "complete_set"}
    },
    {
