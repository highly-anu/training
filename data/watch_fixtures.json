      "state": {"reps": 5, "weightKg": 24, "setsDone": 0, "resting": true, "nextTitle": "Double KB Front Squat", "nextValue": "Set 2/3  5 Reps @ 2x24 kg"},
      "expect": {"title": "Double KB Front Squat  2x24 kg", "a": ["REPS", "5"], "b": ["SET", "1/3"], "gauge": ["SET", "1/3"],
                 "lines": ["Next: Double KB Front Squat", "Set 2/3  5 Reps @ 2x24 kg"], "lap": "complete_set", "outcome": "complete_set"}
