      "screen": {"template": "sets", "title": ["name", "side"], "a": "cumulative", "b": "set", "gauge": "set", "lines": "phases",
                 "lap": "complete_set", "phases": ["Roll", "Post", "Bridge", "Sweep", "Stand"],
                 "behaviours": {"side_tracked": true, "cumulative_target": 100}},
      "state": {"reps": 1, "weightKg": 16, "setsDone": 3, "repsDone": 3, "sideIsLeft": true, "nextTitle": "Rest", "nextValue": "0:45"},
      "expect": {"title": "Turkish Get-Up  Left", "a": ["TOTAL", "3/100"], "b": ["SET", "4/10"], "gauge": ["SET", "4/10"],
                 "lines": ["Roll > Post > Bridge > Sweep > Stand", "Next: Rest"], "lap": "complete_set", "outcome": "complete_set"}
