<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
  <!-- The glance card's icons (GlanceView.mc), beside each value as on Garmin's
       own cards: the same white-on-transparent SVGs as icons.xml, tinted when
       drawn, at about the glance font's cap height. Scoped to the glance (which
       makes them the app's too); icons.xml keeps its 46 out of the 64 KB glance. -->
  <bitmap id="GlKettlebell" filename="icons/cat/cat_kettlebell.svg"
          scaleX="6%" scaleY="6%" scaleRelativeTo="screen"
          automaticPalette="false" packingFormat="default"
          scope="glance" />
