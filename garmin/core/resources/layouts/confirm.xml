<layouts>
  <!--
    The Personality Library's Delete Confirmation: the destructive hint at the confirm
    button (START on a fenix) and the reject hint at the reject button (DOWN on a
    fenix 9), with the body in the system confirmation font. WatchUi.Confirmation only
    does yes/no, so Garmin documents building this one from selectors.
  -->
  <layout id="DiscardConfirm">
    <bitmap id="deleteHint" personality="confirmation_icon__hint_delete confirmation_loc__hint_delete" />
    <bitmap id="rejectHint" personality="confirmation_icon__hint_reject confirmation_loc__hint_reject" />
    <text-area id="body" text="@Strings.DiscardQ" personality="
        confirmation_color_dark__body
        confirmation_size__body
        confirmation_loc__body
        confirmation_font__body" />
  </layout>
</layouts>
