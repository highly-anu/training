<properties>
  <!-- Default backend. Override per-device in Garmin Connect Mobile settings. -->
  <property id="apiBaseUrl" type="string">https://training-api.fly.dev/api</property>
  <!-- Web app base URL used to build the scan-to-claim QR (<webBaseUrl>/pair?code=…).
       Empty = encode the raw pairing code instead of a deep link. -->
  <property id="webBaseUrl" type="string"></property>
  <!-- When launched from the watch-face complication/glance, jump straight into
       today's session instead of just opening the today screen. Off by default. -->
  <property id="autoStartOnLaunch" type="boolean">false</property>
  <!-- Demo session: renders a built-in session that exercises every slot type and
       archetype specialization, without pairing or a synced program. Used to
       verify the workout screens in the simulator and on-wrist before an account
       exists. Off by default; never ships enabled. Renamed from demoMode on 2026-10-10:
       the demo store builds stored demoMode=true on the watch, and a stored value
       outlives an update, so the real build reads a key the demo never wrote. -->
  <property id="demoProgrammes" type="boolean">false</property>
  <!-- Workout cues (core Cues.mc). The watch's Settings menu writes the same keys. -->
  <property id="cueTones" type="boolean">true</property>
  <property id="cueVibrate" type="boolean">true</property>
  <!-- "Work in 3, 2, 1, go" before work that starts on a clock (a rest's end). -->
  <property id="leadIn" type="boolean">true</property>
  <!-- The same count after START, before the timer starts (Garmin's Countdown Start). -->
  <property id="countdownStart" type="boolean">true</property>
  <!-- The lead-in's tones, Toybox.Attention TONE_* values: Alert Low (5) for each
       count, Loud Beep (6) for the go. Picked by ear on the watch (Settings ▸
       Lead-in Tones); a custom pitch plays nothing on a watch with a speaker. -->
  <property id="leadTickTone" type="number">5</property>
  <property id="leadGoTone" type="number">6</property>
  <!-- The glance's style (core GlanceView.mc): 0 Next up, 1 Day bar, 2 Ring (the
       glance until 1.12). The watch's Settings ▸ Glance writes the same key. -->
  <property id="glanceStyle" type="number">0</property>
</properties>
