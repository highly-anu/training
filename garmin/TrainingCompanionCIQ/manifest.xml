<?xml version="1.0"?>
<!--
  Connect IQ manifest for the Training Companion watch app.

  Device ids verified against the installed SDK (9.2.0) device downloads:
    fenix943mm  -> "fēnix 9 43mm"
    fenix947mm  -> "fēnix 9 47mm / 51mm"   (one profile covers both sizes)
  The Fenix 9 tops out at on-device Connect IQ API 6.0.3, so minApiLevel 4.0.0
  is safe headroom; CIQ-6-era calls (UserProfile zones, adaptive workout steps,
  QR generation) are additionally guarded at runtime with `has` checks.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
      entry="TrainingCompanionApp"
      id="a1b2c3d4e5f60718293a4b5c6d7e8f90"
      launcherIcon="@Drawables.LauncherIcon"
      name="@Strings.AppName"
      minApiLevel="4.0.0"
      type="watch-app">

    <iq:products>
      <iq:product id="fenix943mm"/>
      <iq:product id="fenix947mm"/>
    </iq:products>

    <iq:permissions>
      <iq:uses-permission id="Communications"/>   <!-- makeWebRequest to our backend -->
      <iq:uses-permission id="Positioning"/>       <!-- GPS during outdoor sessions -->
      <iq:uses-permission id="SensorHistory"/>      <!-- HR / recovery reads -->
      <iq:uses-permission id="UserProfile"/>        <!-- HR zones, FTP (CIQ 9) -->
      <iq:uses-permission id="Background"/>          <!-- buffer flush / prefetch -->
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
