<?xml version="1.0"?>
<!--
  Connect IQ manifest for the Training Companion watch app.

  TODO(sdk): Confirm the exact Fenix 9 product id(s) and minApiLevel against the
  installed SDK's `bin/devices/` list (VS Code: "Monkey C: Edit Application" →
  Products). The id below is a best guess; Garmin device ids look like
  "fenix9" / "fenix951mm" / "fenix947mm". Add the sizes you own.

  minApiLevel 5.0.0 targets the Connect IQ 9 generation (Fenix 9 / Fenix 8 / FR
  970/570 / Venu 4...). CIQ-9-only calls (UserProfile zones, adaptive workout
  steps, QR generation) are additionally guarded at runtime with `has` checks.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application
      entry="TrainingCompanionApp"
      id="a1b2c3d4e5f60718293a4b5c6d7e8f90"
      launcherIcon="@Drawables.LauncherIcon"
      name="@Strings.AppName"
      minApiLevel="5.0.0"
      type="watch-app">

    <!-- TODO(sdk): confirm/extend product ids for the sizes you target. -->
    <iq:products>
      <iq:product id="fenix9"/>
    </iq:products>

    <iq:permissions>
      <iq:uses-permission id="Communications"/>   <!-- makeWebRequest to our backend -->
      <iq:uses-permission id="Positioning"/>       <!-- GPS during outdoor sessions -->
      <iq:uses-permission id="SensorHistory"/>      <!-- HR / recovery reads -->
      <iq:uses-permission id="UserProfile"/>        <!-- HR zones, FTP (CIQ 9) -->
      <iq:uses-permission id="Background"/>          <!-- buffer flush / prefetch -->
    </iq:permissions>

    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
