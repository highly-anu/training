# Personal health data — must not be in image
data/apple_health_export/
data/user_profiles/
data/legacy/
data/*.db
*.db

# Frontend — not needed in backend image
frontend/

# Git
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Production database dumps — personal health data
backups/

# Environment files
.env
.env.local

# Dev/editor
.claude/
.wrangler/
# docs/ stays out, except the JSON schemas the running API validates against:
# training contracts (src/training_contract.load_contract, on every
# /philosophies and generate) and the authoring routes. Without them
# production answered 500 to /api/philosophies.
docs/*
!docs/schemas
*.md
.idea/
.vscode/

# A package's source weeks are read by the scorecard (tools/evaluate_packages.py),
# never at runtime. Its fidelity record is: Explore's philosophy page shows the
# rules, inventions and open questions (src/explore_philosophy.py).
data/packages/*/source_weeks.yaml

# The modality scheduler's test fixture package (fixture_packages.py).
test_packages/
fixture_packages.py

# Logs / temp
data/api_errors.txt
