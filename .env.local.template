# Local-development overrides — copy to .env.local (gitignored). Loaded after
# .env with override=True by api.py and run_migration.py, so these win locally
# and never reach Fly (fly secrets) or the Docker image (.dockerignore).
#
# No Supabase → src/auth.py bypasses JWT checks and every request runs as
# 'local-dev-user'. Empty is deliberate: an absent key would fall through to
# the production value in .env.
# The same empty value also enables the Dev Lab authoring routes
# (AUTHORING_ENABLED is only needed where SUPABASE_URL is set).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Local Postgres (brew services start postgresql@14 && createdb training_test),
# the same database the SQL test suites use. Apply each file in migrations/ once:
#   python run_migration.py --list   → then run_migration.py <name> per file
DATABASE_URL=postgresql://localhost:5432/training_test?sslmode=disable
# The Vite dev server — CORS allow-list and the Strava OAuth redirect target.
FRONTEND_URL=http://localhost:5173
