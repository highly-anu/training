# Production-shaped backend config. Fill with: op inject -i .env.template -o .env
# For local development copy .env.local.template to .env.local — it layers over
# this file (api.py loads it with override=True) and needs no secrets.

SUPABASE_URL=op://Personal/training-secrets/Backend/SUPABASE_URL
SUPABASE_JWT_SECRET=op://Personal/training-secrets/Backend/SUPABASE_JWT_SECRET
# Deletes the Supabase user in DELETE /api/account (src/account.py). Without it
# the route answers 503 and removes nothing.
SUPABASE_SERVICE_ROLE_KEY=op://Personal/training-secrets/Backend/SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=op://Personal/training-secrets/Backend/DATABASE_URL
FRONTEND_URL=op://Personal/training-secrets/Backend/FRONTEND_URL

# ── Strava (optional) ────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=op://Personal/training-secrets/Strava/STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=op://Personal/training-secrets/Strava/STRAVA_CLIENT_SECRET

# ── Garmin Connect (optional) ────────────────────────────────────────────────
# Absent credentials leave the whole Garmin feature inert rather than broken:
# is_configured() is False, /api/oauth/garmin/authorize answers 503, and the
# Connections tab shows "not configured". Requires an approved Garmin Connect
# Developer Program application.
GARMIN_CLIENT_ID=op://Personal/training-secrets/Garmin/GARMIN_CLIENT_ID
GARMIN_CLIENT_SECRET=op://Personal/training-secrets/Garmin/GARMIN_CLIENT_SECRET
# Shared secret embedded in the webhook URL registered with Garmin, e.g.
#   https://training-api.fly.dev/api/webhooks/garmin/activities?t=<this>
# Generate with: openssl rand -hex 32
GARMIN_WEBHOOK_SECRET=op://Personal/training-secrets/Garmin/GARMIN_WEBHOOK_SECRET
# Override only for local testing against a stub (see test_garmin_webhook.py).
# GARMIN_API_BASE=https://apis.garmin.com

# ── In-app authoring (optional) ──────────────────────────────────────────────
# The POST/PUT routes for exercises, archetypes, modalities and frameworks write
# YAML into the running container. They always require a signed-in user and are
# additionally disabled unless this is set. Local dev (no SUPABASE_URL) allows
# them without it — see _authoring_enabled() in api.py.
# AUTHORING_ENABLED=1

# The package builder (docs/roadmap.md item 21): who may describe a method and
# keep methods of their own — off | dev (the default: accounts whose token
# carries the `dev` role in app_metadata.roles) | all. And how many builds an
# athlete may start a day (5).
# PACKAGE_BUILDER=dev
# PACKAGE_BUILDER_DAILY_LIMIT=5
# The model that writes a method (src/package_builder.py). Without the key the
# builder says it is unavailable. Effort (low | medium | high | xhigh | max;
# default high) and the model id (default claude-opus-5-5) may be overridden.
# ANTHROPIC_API_KEY=            (a 1Password reference here once the builder is turned on)
# PACKAGE_BUILDER_EFFORT=high
# PACKAGE_BUILDER_MODEL=claude-opus-5-5
