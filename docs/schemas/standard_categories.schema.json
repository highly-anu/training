{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "standard_categories.schema.json",
  "title": "Standard categories",
  "description": "data/benchmarks/categories.yaml: the groups standards are listed in, in order. A package may add its own in its standards.yaml.",
  "type": "object",
  "required": ["categories"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"}
        }
      }
    }
  }
}
