{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "archetype.schema.json",
  "title": "Workout Archetype",
  "description": "A reusable workout shape. Defines the structure of a session — how many slots, of what type, in what format — without specifying which exercises fill them. The selector populates slots with exercises at generation time.",
  "type": "object",
  "required": [
    "id",
    "name",
    "modality",
    "category",
    "duration_estimate_minutes",
    "slots"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Unique slug. e.g. '3x5_linear', 'long_zone_2', 'amrap_20min'"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name. e.g. '3×5 Linear Strength', 'Long Zone 2 Run'"
    },
    "modality": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Primary modality this archetype develops. Use an existing modality ID or define a new one in your package's philosophy scope."
    },
    "training_levels": {
      "type": "array",
      "description": "Training levels for which this archetype is appropriate.",
      "items": {
        "type": "string",
        "enum": [
          "novice",
          "intermediate",
          "advanced",
          "elite"
        ]
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "strength",
        "conditioning",
        "movement_skill",
        "gpp_durability",
        "kettlebell",
        "recovery",
        "rehab",
        "combat_sport"
      ],
      "description": "Broad session category used for scheduling and tagging."
    },
    "duration_estimate_minutes": {
      "type": "integer",
      "minimum": 5,
      "description": "Expected session length in minutes, including warm-up and cool-down. Used to match against constraint session_time_minutes."
    },
    "slots": {
      "type": "array",
      "description": "Ordered list of exercise slots within the session. Each slot defines what role an exercise should play and the volume parameters for that role.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "slot_type"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "description": "What this slot does in the session. e.g. 'primary_compound', 'accessory', 'conditioning_finisher', 'skill_practice'"
          },
          "slot_type": {
            "type": "string",
            "enum": [
              "sets_reps",
              "time_domain",
              "distance",
              "amrap",
              "amrap_movement",
              "emom",
              "for_time",
              "rounds_for_time",
              "skill_practice",
              "static_hold"
            ],
            "description": "The format that determines how volume is measured."
          },
          "sets": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": [
              "integer",
              "string"
            ],
            "description": "Integer or range string e.g. '3-5'"
          },
          "duration_sec": {
            "type": "integer",
            "minimum": 1,
            "description": "For time_domain or emom slots."
          },
          "distance_m": {
            "type": "integer",
            "minimum": 1,
            "description": "For distance slots."
          },
          "intensity": {
            "type": "string",
            "enum": [
              "max",
              "max_effort",
              "heavy",
              "submaximal",
              "progressing",
              "moderate",
              "medium",
              "light",
              "low",
              "high",
              "bodyweight",
              "zone1",
              "zone2",
              "zone3",
              "zone4",
              "zone4_5",
              "zone5"
            ],
            "description": "Intensity target for this slot."
          },
          "intensity_pct_1rm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Exact %1RM if applicable. e.g. 0.80 = 80%."
          },
          "rpe_target": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "rest_sec": {
            "type": "integer",
            "minimum": 0,
            "description": "Rest in seconds between sets."
          },
          "exercise_filter": {
            "type": "object",
            "description": "Constraints on which exercises can fill this slot. Narrows exercise selection.",
            "properties": {
              "category": {
                "type": "string"
              },
              "movement_pattern": {
                "type": "string"
              },
              "bilateral": {
                "type": "boolean"
              },
              "equipment_required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude_movement_pattern": {
                "type": "string"
              },
              "exercise_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Only these exercises may fill the slot (still level, equipment and injury filtered). For a slot whose events are fixed by rules, e.g. a pentathlon's five."
              }
            },
            "additionalProperties": false
          },
          "hold_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "description": "Alternative to duration_sec."
          },
          "rounds": {
            "type": "integer",
            "minimum": 1
          },
          "reps_per_round": {
            "type": "integer",
            "minimum": 1
          },
          "skip_exercise": {
            "type": "boolean",
            "description": "If true, selector skips exercise lookup for this slot."
          },
          "notes": {
            "type": "string"
          },
          "work_sec": {
            "type": "integer",
            "description": "Work interval length in seconds (interval slots)."
          },
          "pack_load_kg": {
            "description": "Pack weight for loaded carry / step-up slots."
          },
          "parent_slot_role": {
            "type": "string",
            "description": "Links an amrap_movement component to the AMRAP slot it belongs to."
          },
          "time_cap_sec": {
            "type": "integer",
            "description": "Time cap for an amrap/for_time slot. Read by progression._density_slot as the duration fallback."
          },
          "paced": {
            "type": "boolean",
            "description": "The slot is worked at a target RPM taken from the chosen exercise's competition_pace (max_reps / minutes); the load carries it as target_rpm and the watch paces the set."
          },
          "switch_at_sec": {
            "type": "integer",
            "minimum": 1,
            "description": "A one-arm block's hand switch, in seconds into the work (a timed block's or each interval's): the load carries it as switch_at_sec, and both watches cue Switch hands and show Left or Right."
          },
          "rest_until_hr_pct": {
            "type": "number",
            "minimum": 50,
            "maximum": 90,
            "description": "An interval (emom) slot's rest ends once heart rate falls below this share of the athlete's max HR, and rest_sec becomes its cap. The load carries it, with the slot's zone; the server sends it to the watches in bpm (restUntilHr)."
          },
          "standard": {
            "description": "The standard (data/benchmarks id) this slot measures, and which logged field is the result. A string is the id, the result kind following from the slot type. Packages point at commons standards, never the reverse.",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "duration",
                      "rounds",
                      "reps",
                      "hold",
                      "load",
                      "distance"
                    ],
                    "description": "duration: the time a for-time piece took; rounds: an AMRAP's rounds; reps: max reps (the best set, or reps in a timed set); hold: seconds held; load: a single's kg ÷ bodyweight; distance: metres covered."
                  }
                }
              }
            ]
          }
        }
      }
    },
    "scaling": {
      "type": "object",
      "description": "How the archetype adapts under common constraint scenarios.",
      "properties": {
        "deload": {
          "type": "object",
          "description": "Modifications applied during a deload week.",
          "properties": {
            "volume_multiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0
            },
            "intensity_pct": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0
            },
            "drop_slots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "time_limited": {
          "type": "object",
          "description": "How to abbreviate if session_time_minutes is shorter than duration_estimate_minutes.",
          "properties": {
            "drop_slots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Role names to drop first."
            },
            "notes": {
              "type": "string"
            },
            "volume_multiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0
            },
            "intensity_pct": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0
            }
          },
          "additionalProperties": false
        },
        "equipment_limited": {
          "type": "object",
          "description": "Substitute equipment or approaches if required equipment is unavailable.",
          "properties": {
            "substitutions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "missing_equipment",
                  "substitute_approach"
                ],
                "properties": {
                  "missing_equipment": {
                    "type": "string"
                  },
                  "substitute_approach": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "required_equipment": {
      "type": "array",
      "description": "Equipment needed to run this archetype as written. If any item is missing and no scaling.equipment_limited rule exists, this archetype is unavailable.",
      "items": {
        "type": "string",
        "enum": [
          "barbell",
          "rack",
          "plates",
          "kettlebell",
          "dumbbell",
          "pull_up_bar",
          "rings",
          "parallettes",
          "rower",
          "bike",
          "ski_erg",
          "ruck_pack",
          "sandbag",
          "sled",
          "tire",
          "medicine_ball",
          "resistance_band",
          "rope",
          "box",
          "ghd",
          "jump_rope",
          "open_space"
        ]
      },
      "default": []
    },
    "applicable_phases": {
      "type": "array",
      "description": "Phase kinds (data/commons/phase_kinds.yaml) in which this archetype is appropriate — matched against the kind of the program phase, never its package-local id. If empty, applicable in all phases.",
      "items": {
        "type": "string",
        "enum": [
          "active",
          "transition",
          "specific",
          "base",
          "build",
          "peak",
          "taper",
          "deload",
          "maintenance",
          "rehab",
          "post_op",
          "recovery"
        ]
      },
      "default": []
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "description": "This archetype is a test of one or more standards: its slots with `standard` produce the results. A test is placed only by a phase's `tests:` (philosophy.yaml) unless `selectable` is true; its standard slots are prescribed exactly as written (no weekly ramp, level, phase or deload scaling).",
      "properties": {
        "selectable": {
          "type": "boolean",
          "default": false,
          "description": "Whether ordinary archetype selection may pick it too. Default false: tests are placed, not chosen."
        }
      }
    }
  }
}
