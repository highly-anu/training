{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Training levels",
  "description": "data/commons/training_levels.yaml: the athlete's levels in order (src/levels.py).",
  "type": "object",
  "required": ["default", "levels"],
  "additionalProperties": false,
  "properties": {
    "default": {"type": "string"},
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "distance_multiplier", "scaling", "standard_rung"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "label": {"type": "string"},
          "distance_multiplier": {"type": "number", "exclusiveMinimum": 0},
          "unlocks_all": {"type": "boolean"},
          "scaling": {
            "description": "The share of an elite prescription this level does, per dimension (src/level_scaling.py).",
            "type": "object",
            "required": ["load", "volume", "time", "distance"],
            "additionalProperties": false,
            "properties": {
              "load": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "volume": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "time": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "distance": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          },
          "standard_rung": {
            "description": "The rung of a standard's ladder (benchmarks_data.LEVELS) this level trains toward.",
            "enum": ["entry", "intermediate", "advanced", "elite"]
          }
        }
      }
    }
  }
}
