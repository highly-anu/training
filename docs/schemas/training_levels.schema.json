{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Training levels",
  "description": "data/commons/training_levels.yaml: the athlete's levels in order (src/levels.py).",
  "type": "object",
  "required": ["default", "levels"],
  "additionalProperties": false,
  "properties": {
    "default": {"type": "string"},
    "levels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "distance_multiplier"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "label": {"type": "string"},
          "distance_multiplier": {"type": "number", "exclusiveMinimum": 0},
          "unlocks_all": {"type": "boolean"}
        }
      }
    }
  }
}
