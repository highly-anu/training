{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Executable training contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources", "tracks"],
  "properties": {
    "version": {"const": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tracks": {"type": "object", "additionalProperties": {"$ref": "#/definitions/track"}}
  },
  "definitions": {
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["training_levels", "notes", "modules"],
      "properties": {
        "training_levels": {"$ref": "#/definitions/levels"},
        "notes": {"type": "string"},
        "requires_kettlebell_pair": {"type": "boolean"},
        "test_module": {"type": "string"},
        "deload_phases": {"type": "array", "items": {"type": "string"}},
        "level_seeds": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/module"}}
      }
    },
    "levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["novice", "intermediate", "advanced", "elite"]}},
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "archetype_id", "modality", "training_levels", "exposures_per_week", "min_spacing_days", "max_rpe", "progression"],
      "anyOf": [{"required": ["blocks"]}, {"required": ["variants", "rotation"]}],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"},
        "archetype_id": {"type": "string"}, "modality": {"type": "string"},
        "training_levels": {"$ref": "#/definitions/levels"},
        "exposures_per_week": {"type": "integer", "minimum": 1, "maximum": 6},
        "exposures_by_days": {"type": "object", "propertyNames": {"pattern": "^[1-7]$"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 6}, "description": "Weekly exposures by the days the athlete trains (the nearest listed count at or below theirs); 0 leaves the module out. Overrides exposures_per_week."},
        "min_spacing_days": {"type": "integer", "minimum": 1, "maximum": 7},
        "max_rpe": {"type": "integer", "minimum": 1, "maximum": 10},
        "deload_keep": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "requires_mastery": {"type": "array", "items": {"type": "string"}},
        "may_share_day": {"type": "boolean", "description": "An optional module that may join a day the essential modules use when its minutes fit beside them (Wildman's programs stack into one session); free days are still taken first."},
        "never_with": {"type": "array", "items": {"type": "string"}, "description": "Modules this optional one never shares a day with (BJJ's conditioning stays off class days)."},
        "when_mastered": {"type": "boolean", "description": "Joins the week only once `requires_mastery` is confirmed (mastered_exercises or the level's seeds); until then it is left out and the program says so, rather than the track refusing."},
        "optional": {"type": "boolean", "description": "Supplementary work the method lets the athlete skip: placed only on days no essential module uses, left out with its reason when none is free or its movement is ruled out."},
        "progression": {
          "type": "object", "additionalProperties": false, "required": ["model"],
          "properties": {
            "model": {"enum": ["density_cycle", "skill_hold", "timed_cycle", "load_per_exposure"]},
            "round_kg": {"type": "number", "exclusiveMinimum": 0, "description": "load_per_exposure: weights round to this plate step."},
            "stall": {"type": "object", "additionalProperties": false, "required": ["failures", "reset_pct"],
                      "description": "load_per_exposure: misses in a row at one weight before it resets by reset_pct; a lift that stalls again after `resets` resets (default 1) has finished its progression and holds.",
                      "properties": {"failures": {"type": "integer", "minimum": 1}, "reset_pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
                                     "resets": {"type": "integer", "minimum": 0}}},
            "lifts": {"type": "object", "description": "load_per_exposure: per lift (exercise id), the kg added after a made exposure — increments_kg[0] for the first `first_exposures`, then a step smaller, and a step smaller after each reset.",
                      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["increments_kg"],
                                               "properties": {"increments_kg": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
                                                              "first_exposures": {"type": "integer", "minimum": 1}}}},
            "reps_start": {"type": "integer", "minimum": 1},
            "reps_step": {"type": "integer", "minimum": 1},
            "reps_max": {"type": "integer", "minimum": 1},
            "rounds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
            "interval_sec": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 30}, "description": "Per stage of `rounds`, the interval each round takes (default 60: an EMOM). Wildman's swing program runs 60-second minutes, then 90-second start/stop rounds."},
            "cues": {"type": "array", "items": {"type": ["string", "null"]}, "description": "Per stage of `rounds`, what changes in the movement (start/stop: park the bell between reps)."},
            "duration_start_sec": {"type": "integer", "minimum": 60},
            "duration_step_sec": {"type": "integer", "minimum": 1},
            "duration_max_sec": {"type": "integer", "minimum": 60}
          },
          "allOf": [
            {"if": {"properties": {"model": {"const": "density_cycle"}}}, "then": {"required": ["reps_start", "reps_step", "reps_max", "rounds"]}},
            {"if": {"properties": {"model": {"const": "timed_cycle"}}}, "then": {"required": ["duration_start_sec", "duration_step_sec", "duration_max_sec"]}},
            {"if": {"properties": {"model": {"const": "load_per_exposure"}}}, "then": {"required": ["lifts"]}}
          ]
        },
        "variants": {"type": "array", "minItems": 1,
                     "description": "Sessions that alternate (Starting Strength's Workout A and B, the Texas Method's three days): the rotation names one per exposure, so the module runs A-B-A one week and B-A-B the next.",
                     "items": {"type": "object", "additionalProperties": false, "required": ["id", "blocks"],
                               "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "archetype_id": {"type": "string"},
                                              "blocks": {"$ref": "#/definitions/blocks"}}}},
        "rotation": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Variant ids in exposure order, repeating."},
        "blocks": {"$ref": "#/definitions/blocks"}
      }
    },
    "blocks": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "exercise_id", "slot_type"],
          "properties": {
            "role": {"type": "string"}, "exercise_id": {"type": "string"},
            "slot_type": {"enum": ["emom", "time_domain", "skill_practice", "sets_reps", "static_hold"]},
            "alternatives": {"type": "array", "items": {"type": "string"}, "description": "Substitutes the method accepts, in order: the first the athlete's equipment and injuries allow is prescribed."},
            "sets": {"type": "integer", "minimum": 1},
            "reps": {"type": "integer", "minimum": 1},
            "hold_sec": {"type": "integer", "minimum": 5},
            "rest_sec": {"type": "integer", "minimum": 0},
            "rpe_target": {"type": "number", "minimum": 1, "maximum": 10},
            "deload_keep": {"type": "number", "minimum": 0, "maximum": 1, "description": "The share a deload keeps of this block; 0 drops it."},
            "optional": {"type": "boolean", "description": "A supporting block left out, and said so, when none of its options fits the equipment or injuries; an essential block refuses instead."},
            "duration_sec": {"type": "integer", "minimum": 60},
            "rest_after_sec": {"type": "integer", "minimum": 0},
            "target_rpm": {"type": "number", "exclusiveMinimum": 0},
            "loaded": {"type": "boolean"}, "notes": {"type": "string"},
            "standard": {"type": "string"},
            "progresses": {"type": "boolean", "description": "Carries the module's progression without a bell (an easy run's minutes); a loaded block always does."},
            "intensity": {"enum": ["zone1", "zone2", "low", "moderate", "high"], "description": "A prescribed intensity; a zone counts the block's heart rate in the analytics."},
            "pct": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "load_per_exposure: a share of the lift's last made weight (the Texas Method's Monday 5×5 at about 90 %); such a block reads its lift and does not move it on."},
            "advances": {"type": "boolean", "description": "load_per_exposure: whether a made exposure of this block moves its lift on (default: a loaded block at full weight does)."},
            "to_failure": {"type": "boolean", "description": "Sets to failure (Rippetoe's chin-ups): no fixed reps."}
          },
          "allOf": [{"if": {"properties": {"slot_type": {"enum": ["time_domain", "skill_practice"]}}}, "then": {"required": ["duration_sec"]}},
                    {"if": {"properties": {"slot_type": {"const": "sets_reps"}}}, "then": {"required": ["sets", "duration_sec"],
                                                                                        "anyOf": [{"required": ["reps"]}, {"required": ["to_failure"]}]}},
                    {"if": {"properties": {"slot_type": {"const": "static_hold"}}}, "then": {"required": ["sets", "hold_sec"]}}]
        }}
  }
}
