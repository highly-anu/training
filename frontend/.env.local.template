# Local dev (copy to .env.local, gitignored). Leave the Supabase vars empty to
# skip login and run as 'local-dev-user' — the same identity the API assumes
# when its own SUPABASE_URL is empty (see ../.env.local.template).
VITE_API_BASE_URL=http://localhost:8000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# To sign in as yourself against a real backend instead, fill these from 1Password:
# VITE_SUPABASE_URL=op://Personal/training-secrets/Frontend Dev/VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY=op://Personal/training-secrets/Frontend Dev/VITE_SUPABASE_ANON_KEY
